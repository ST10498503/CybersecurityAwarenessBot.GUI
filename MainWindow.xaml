<Window x:Class="CybersecurityAwarenessBot.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Assistant"
        Height="700" Width="950"
        MinHeight="550" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="#101827"
        Loaded="Window_Loaded">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#1D2B42"
                CornerRadius="12"
                Padding="16"
                Margin="0,0,0,16">

            <StackPanel>
                <TextBlock x:Name="LogoText"
                           Text="CYBER SECURITY"
                           FontFamily="Consolas"
                           FontSize="12"
                           Foreground="#65E6D1"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>

                <TextBlock Text="CYBERSECURITY AWARENESS"
                           Foreground="#65E6D1"
                           FontSize="23"
                           FontWeight="Bold"/>

                <TextBlock Text="Your friendly online safety assistant"
                           Foreground="White"
                           FontSize="14"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Background="#172235"
                CornerRadius="12"
                Padding="16"
                Margin="0,0,0,16">

            <ScrollViewer x:Name="ChatScrollViewer"
                          VerticalScrollBarVisibility="Auto">

                <StackPanel x:Name="ChatPanel">
                    <Border Background="#263852"
                            CornerRadius="10"
                            Padding="12"
                            Margin="0,0,0,10"
                            HorizontalAlignment="Left"
                            MaxWidth="600">

                        <TextBlock Text="Hello! I'm your Cybersecurity Awareness Assistant. Ask me about passwords, scams, privacy or phishing."
                                   Foreground="White"
                                   TextWrapping="Wrap"
                                   FontSize="15"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <TextBox x:Name="MessageInput"
                 Grid.Row="2"
                 Height="48"
                 FontSize="15"
                 Padding="12"
                 Background="#F1F5F9"
                 Foreground="#101827"
                 BorderThickness="0"
                 VerticalContentAlignment="Center"
                 ToolTip="Type your cybersecurity question"
                 Margin="0,0,0,12"
                 KeyDown="MessageInput_KeyDown"/>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button x:Name="ClearChatButton"
                    Content="Clear Chat"
                    Width="110"
                    Height="42"
                    Margin="0,0,10,0"
                    Background="#263852"
                    Foreground="White"
                    FontSize="14"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="ClearChatButton_Click"/>

            <Button x:Name="SendButton"
                    Content="Send"
                    Width="110"
                    Height="42"
                    Background="#65E6D1"
                    Foreground="#101827"
                    FontWeight="Bold"
                    FontSize="15"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="SendButton_Click"/>
        </StackPanel>
    </Grid>
</Window>